.vs/
.vscode/
*.pidb
*.sln.iml

# Rider
.idea/
.idea_modules/
*.swp
*.swo
*~

# Visual Studio Code
.vscode
.vscode/

# Resharper
_ReSharper*/
*.csproj.user

