[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/

# ========== UNITY GENERATED FILES ==========
*.meta
!Assets/**/*.meta
!ProjectSettings/**/*.meta

# Keep version and specific configs
!ProjectSettings/ProjectVersion.txt
!ProjectSettings/ProjectSettings.asset

# ========== EXCLUDES ==========
# Don't ignore these:
!Assets/
!Assets/**
!ProjectSettings/ProjectVersion.txt
!ProjectSettings/ProjectSettings.asset
